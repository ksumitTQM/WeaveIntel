@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string NavClass(string name) => string.Equals(controllerName, name, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WeaveIntel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark wi-navbar">
            <div class="container">
                <a class="navbar-brand wi-brand" asp-controller="Home" asp-action="Index">
                    <span class="wi-brand-mark" aria-hidden="true">&#9992;</span> WeaveIntel
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="@NavClass("Home")" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Products")" asp-controller="Products" asp-action="Index">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Routes")" asp-controller="Routes" asp-action="Index">Routes</a>
                        </li>
                    </ul>
                    <environment include="Development">
                        <a class="btn btn-outline-light btn-sm" href="/swagger">API docs</a>
                    </environment>
                </div>
            </div>
        </nav>
    </header>

    <main class="container wi-main" role="main">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="wi-footer">
        <div class="container d-flex justify-content-between flex-wrap">
            <span>&copy; @DateTime.UtcNow.Year WeaveIntel - Airline product tracking</span>
            <span class="text-muted">Demo data held in memory</span>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
