@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="wi-card text-center py-5">
    <h1 class="display-6 text-danger">Something went wrong</h1>
    <p class="lead">The request could not be completed.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">Request ID: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
</div>
