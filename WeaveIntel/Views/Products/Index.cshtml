@model ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <div>
        <h1 class="wi-page-title mb-0">Products</h1>
        <p class="text-muted mb-0">Fare bundles, ancillaries and upgrades across the network.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New product</a>
</div>

<form method="get" asp-action="Index" class="wi-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label asp-for="Search" class="form-label">Search</label>
            <input asp-for="Search" class="form-control" placeholder="Code, name or owner" />
        </div>
        <div class="col-md-3">
            <label asp-for="Category" class="form-label">Category</label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<ProductCategory>()" class="form-select">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label">Lifecycle status</label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<LifecycleStatus>()" class="form-select">
                <option value="">All statuses</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            @if (Model.HasFilters)
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
            }
        </div>
    </div>
</form>

<div class="wi-card p-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th class="text-end">Base price</th>
                    <th class="text-end">Revenue (EUR)</th>
                    <th class="text-end">Active listings</th>
                    <th>Launch</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">No products match the current filters.</td>
                    </tr>
                }
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td><code>@item.Code</code></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold">@item.Name</a>
                        </td>
                        <td>@item.Category.DisplayName()</td>
                        <td><span class="wi-badge @item.Status.CssClass()">@item.Status.DisplayName()</span></td>
                        <td>@item.Owner</td>
                        <td class="text-end">@item.BasePrice.ToString("N2") @item.Currency</td>
                        <td class="text-end">@item.TotalRevenue.ToString("N0")</td>
                        <td class="text-end">@item.ActiveAvailabilities</td>
                        <td>@(item.LaunchDate.HasValue ? item.LaunchDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">View</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="text-muted small mt-2">@Model.Products.Count product(s) shown.</p>
