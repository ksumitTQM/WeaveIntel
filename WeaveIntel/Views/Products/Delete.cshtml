@model Product
@{
    ViewData["Title"] = "Delete product";
}

<h1 class="wi-page-title">Delete product</h1>

<div class="wi-card">
    <div class="alert alert-warning">
        Deleting this product also removes its availability, performance records and lifecycle history. This cannot be undone.
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-3">Code</dt>
        <dd class="col-sm-9"><code>@Model.Code</code></dd>
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category.DisplayName()</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9"><span class="wi-badge @Model.Status.CssClass()">@Model.Status.DisplayName()</span></dd>
        <dt class="col-sm-3">Owner</dt>
        <dd class="col-sm-9">@Model.Owner</dd>
        <dt class="col-sm-3">Availability entries</dt>
        <dd class="col-sm-9">@Model.Availabilities.Count</dd>
        <dt class="col-sm-3">Performance records</dt>
        <dd class="col-sm-9">@Model.PerformanceRecords.Count</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-danger">Delete product</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </form>
</div>
